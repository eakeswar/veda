# Veda backend — copy to server/.env and fill in your keys

# Required for TTS, karaoke, and Telugu translation fallback
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional — custom voice recording alignment (/transcribe)
OPENAI_API_KEY=your_openai_api_key_here

# Optional — require API key on laptop server (leave empty for local dev)
# VEDA_API_KEY=generate-a-long-random-string

# CORS origins for frontend (comma-separated)
# VEDA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Laptop defaults (everything runs locally until Kaggle is enabled) ──
# Laptop CPU fallback when Kaggle is down
LOCAL_LLM_SIZE=3B
# Kaggle GPU analysis (project-models dataset) — 7B fits T4; 14B may OOM
KAGGLE_LLM_SIZE=7B
LLM_PROVIDER=local
TRANSLATE_PROVIDER=local
LAYOUT_PROVIDER=local
UPSCALE_PROVIDER=local

# ── Kaggle GPU tunnel (runtime — while notebook session is open) ──
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# KAGGLE_ENABLED=true
# KAGGLE_API_BASE_URL=https://xxxx.trycloudflare.com
# KAGGLE_API_SECRET=your-strong-random-secret-here
# KAGGLE_API_TIMEOUT=120

# When Kaggle providers are enabled:
# LLM_PROVIDER=kaggle
# TRANSLATE_PROVIDER=kaggle
# LAYOUT_PROVIDER=kaggle
# Image upscale stays on laptop (Lanczos only — no GPU model)

# ── Kaggle official API (publish project-models from laptop) ──
# New token: kaggle.com/settings/api -> Generate New Token
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_API_TOKEN=KGAT_...
# KAGGLE_DATASET_SLUG=project-models
#
# Legacy: KAGGLE_USERNAME + KAGGLE_KEY (kaggle.json)

# auto = use Kaggle when KAGGLE_ENABLED=true, else local; falls back to local on error
