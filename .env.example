# Veda frontend — optional overrides (defaults to http://127.0.0.1:8765)

# Single base URL for all backend calls (preferred):
# VITE_API_BASE_URL=http://127.0.0.1:8765

# Or override individual endpoints:
# VITE_LAYOUT_API_URL=http://127.0.0.1:8765
# VITE_ANALYZE_API_URL=http://127.0.0.1:8765/analyze
# VITE_TTS_API_URL=http://127.0.0.1:8765/tts
# VITE_UPLOAD_API_URL=http://127.0.0.1:8765/upload_pdf

# If VEDA_API_KEY is set on the backend, pass it from the frontend:
# VITE_VEDA_API_KEY=your-api-key
